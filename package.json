{
  "name": "quiz-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "منصة اختبار لحظي مباشرة - اختبار الاقترانات",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "check:sql": "node scripts/check-sql.mjs && node scripts/check-deps.mjs",
    "render:check": "node scripts/render-check.mjs",
    "check": "npm run typecheck && npm run check:sql && npm run render:check",
    "test:e2e": "node scripts/e2e.mjs",
    "test:join": "node scripts/test-join.mjs",
    "test:login": "node scripts/test-login.mjs",
    "verify:port": "node scripts/verify-port.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "generate:bank": "node scripts/generate-bank.mjs",
    "seed": "node scripts/seed.mjs",
    "create-teacher": "node scripts/create-teacher.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "libpg-query": "^18.1.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}